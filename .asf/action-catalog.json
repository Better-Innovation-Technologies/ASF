      "executor_kind": "human",
      "default_executor": "dev-lead",
      "target_kind": "gate",
      "idempotent": true,
      "blocks_merge": true,
      "parameters": {
        "type": "object",
        "required": [
          "gate",
          "reason"
        ],
        "properties": {
          "gate": {
            "type": "string",
            "enum": [
              "L1",
              "MR",
              "release"

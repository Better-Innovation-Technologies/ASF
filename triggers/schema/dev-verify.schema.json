{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asf.dev-verify/1",
  "title": "ASF Dev Agent — verification result",
  "description": "Written by the coding CLI to asf/verify.json at the end of the `verify` phase: one entry per test command run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "tests"
  ],
  "properties": {
    "schema": {
      "enum": [
        "asf.dev-verify/1"
      ]
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repo",
          "command",
          "ok"
        ],
        "properties": {
          "repo": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "command": {
            "type": "string",
            "minLength": 2
          },
          "ok": {
            "type": "boolean"
          },
          "passed": {
            "type": "integer",
            "minimum": 0
          },
          "failed": {
            "type": "integer",
            "minimum": 0
          },
          "summary": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    }
  }
}

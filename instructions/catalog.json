{
  "$schema": "https://git.bit-farm.it/bit-farm-public/pico/-/raw/main/schema/pico-instructions-catalog.schema.json",
  "package": "asf-instructions-catalog/1",
  "version": "1.0.0",
  "asf_version": "8.6",
  "header": "header.md",
  "project_rules": "project-rules.md",
  "host_placeholders": [
    {
      "name": "project_name",
      "description": "Project name, from the project's product.md or the host"
    },
    {
      "name": "asf_version",
      "description": "ASF version the project follows"
    },
    {
      "name": "composed_at",
      "description": "Date of composition (YYYY-MM-DD)"
    },
    {
      "name": "catalog_ref",
      "description": "Catalog repository and ref the modules come from"
    }
  ],
  "categories": [
    {
      "id": "language",
      "title": "Language",
      "order": 1,
      "cardinality": "one",
      "required": true,
      "description": "Which language for code, comments, commits and domain terms."
    },
    {
      "id": "localization",
      "title": "Localization",
      "order": 2,
      "cardinality": "one",
      "required": false,
      "description": "How user-facing text is managed."
    },
    {
      "id": "principles",
      "title": "Principles",
      "order": 3,
      "cardinality": "one",
      "required": true,
      "description": "The non-negotiable engineering principles of ASF."
    },
    {
      "id": "topology",
      "title": "System topology",
      "order": 4,
      "cardinality": "one",
      "required": true,
      "description": "How the system is split into deployable units."
    },
    {
      "id": "structure",
      "title": "Internal structure",
      "order": 5,
      "cardinality": "one",
      "required": false,
      "description": "How the code inside one deployable unit is organised."
    },
    {
      "id": "communication",
      "title": "Communication between services",
      "order": 6,
      "cardinality": "many",
      "required": false,
      "description": "How services talk; only for distributed topologies."
    },
    {
      "id": "frontend",
      "title": "Frontend stack",
      "order": 7,
      "cardinality": "one",
      "required": false,
      "description": "Frontend framework and its conventions."
    },
    {
      "id": "backend",
      "title": "Backend stack",
      "order": 8,
      "cardinality": "many",
      "required": false,
      "description": "Backend runtimes and frameworks (one per backend)."
    },
    {
      "id": "database",
      "title": "Database",
      "order": 9,
      "cardinality": "one",
      "required": false,
      "description": "Primary data store and its conventions."
    },
    {
      "id": "code-style",
      "title": "Code style",
      "order": 10,
      "cardinality": "many",
      "required": false,
      "description": "Formatting, linting and naming per language."
    },
    {
      "id": "comments",
      "title": "Comments and documentation",
      "order": 11,
      "cardinality": "one",
      "required": true,
      "description": "How code is commented and documented."
    },
    {
      "id": "testing",
      "title": "Testing",
      "order": 12,
      "cardinality": "many",
      "required": true,
      "description": "Test strategy and kinds of tests."
    },
    {
      "id": "observability",
      "title": "Logging and observability",
      "order": 13,
      "cardinality": "one",
      "required": true,
      "description": "Logging, tracing and metrics."
    },
    {
      "id": "errors",
      "title": "Errors",
      "order": 14,
      "cardinality": "one",
      "required": true,
      "description": "How errors are raised, shaped and reported."
    },
    {
      "id": "security",
      "title": "Security",
      "order": 15,
      "cardinality": "many",
      "required": true,
      "description": "Security baseline and secrets."
    },
    {
      "id": "git",
      "title": "Git workflow",
      "order": 16,
      "cardinality": "one",
      "required": true,
      "description": "Branching, merge requests and commit messages."
    },
    {
      "id": "method",
      "title": "ASF method",
      "order": 17,
      "cardinality": "one",
      "required": true,
      "description": "Sprint execution, artifact templates, labels, layer loaders."
    }
  ],
  "modules": [
    {
      "id": "language-english",
      "category": "language",
      "version": "1.0.0",
      "title": "English everywhere",
      "summary": "Identifiers, comments, commits and docs in English; domain terms mapped once in a glossary.",
      "file": "modules/language/language-english.md",
      "when": [
        "international team",
        "open source",
        "english"
      ],
      "placeholders": [
        {
          "name": "business_language",
          "type": "enum",
          "description": "Language the business speaks",
          "default": "Italian",
          "enum": [
            "English",
            "Italian",
            "Spanish",
            "French",
            "German",
            "Portuguese"
          ]
        },
        {
          "name": "glossary_path",
          "type": "path",
          "description": "Path of the domain glossary",
          "default": "docs/glossary.md"
        }
      ],
      "default": true
    },
    {
      "id": "language-english-code-local-prose",
      "category": "language",
      "version": "1.0.0",

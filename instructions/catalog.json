      "when": [
        "one language ui"
      ],
      "placeholders": [
        {
          "name": "ui_language",
          "type": "enum",
          "description": "Language of the user interface",
          "default": "Italian",
          "enum": [
            "English",
            "Italian",
            "Spanish",
            "French",
            "German",
            "Portuguese"
          ]

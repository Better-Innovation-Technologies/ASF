      "default": true
    },
    {
      "id": "asf-principles",
      "category": "principles",
      "version": "1.0.0",
      "title": "ASF principles",
      "summary": "KISS, DRY, YAGNI, SOLID, 12-Factor, fail fast; no magic values, explicit DTOs, co-located types, anti-patterns.",
      "file": "modules/principles/asf-principles.md",
      "default": true
    },
    {
      "id": "monolith",
      "category": "topology",
      "version": "1.0.0",
      "title": "Monolith",
      "summary": "One deployable application, modular inside.",
      "file": "modules/topology/monolith.md",
      "when": [
        "small product",
        "one team"
      ]
    },
    {
      "id": "modular-monolith",
      "category": "topology",
      "version": "1.0.0",
      "title": "Modular monolith",
      "summary": "One deployable made of modules with enforced boundaries — monolith first.",
      "file": "modules/topology/modular-monolith.md",
      "when": [
        "new product",
        "one or two teams"
      ],
      "placeholders": [
        {
          "name": "modules_root",
          "type": "path",
          "description": "Folder of the modules",
          "default": "src/modules"
        }
      ],
      "default": true
    },
    {
      "id": "microservices",
      "category": "topology",
      "version": "1.0.0",
      "title": "Microservices",
      "summary": "Independently deployable services, one database each, versioned contracts.",
      "file": "modules/topology/microservices.md",
      "when": [
        "several teams",
        "independent scaling",
        "independent releases"
      ],
      "requires": [
        [
          "rest-sync",
          "async-events",
          "grpc"
        ]
      ],
      "placeholders": [
        {
          "name": "services_root",
          "type": "path",
          "description": "Folder (or repo group) of the services",
          "default": "services/"
        }
      ]
    },
    {
      "id": "serverless",
      "category": "topology",
      "version": "1.0.0",
      "title": "Serverless",
      "summary": "Functions and managed services; stateless, idempotent handlers.",
      "file": "modules/topology/serverless.md",
      "when": [
        "event driven",
        "spiky load",
        "cloud functions"
      ],
      "placeholders": [
        {
          "name": "cloud_provider",
          "type": "enum",
          "description": "Cloud provider",
          "default": "AWS",
          "enum": [
            "AWS",
            "Azure",
            "Google Cloud"
          ]
        }
      ]
    },
    {
      "id": "layered",
      "category": "structure",
      "version": "1.0.0",
      "title": "Layered (three-tier)",
      "summary": "Router → service → repository per domain module.",
      "file": "modules/structure/layered.md",
      "when": [
        "crud",
        "simple domain"
      ],
      "placeholders": [
        {
          "name": "be_modules_path",
          "type": "path",
          "description": "Folder of the backend modules",
          "default": "src/modules"
        },
        {
          "name": "be_lib_path",
          "type": "path",
          "description": "Folder of shared backend utilities",
          "default": "src/lib"
        }
      ],
      "default": true
    },
    {
      "id": "hexagonal",
      "category": "structure",
      "version": "1.0.0",
      "title": "Hexagonal (ports and adapters)",
      "summary": "Pure domain at the centre, ports declared by the application, adapters at the edge.",
      "file": "modules/structure/hexagonal.md",
      "when": [
        "complex domain",
        "many integrations",
        "ddd"
      ]
    },
    {
      "id": "clean",
      "category": "structure",
      "version": "1.0.0",
      "title": "Clean architecture",
      "summary": "Entities, use cases, interface adapters, frameworks — dependencies inwards.",
      "file": "modules/structure/clean.md",
      "when": [
        "complex domain",
        "long lived"
      ]
    },
    {
      "id": "vertical-slice",
      "category": "structure",
      "version": "1.0.0",
      "title": "Vertical slices",
      "summary": "Code organised by feature/use case, cohesive slices.",
      "file": "modules/structure/vertical-slice.md",
      "when": [
        "many features",
        "cqrs"
      ]
    },
    {
      "id": "rest-sync",
      "category": "communication",
      "version": "1.0.0",
      "title": "Synchronous REST",
      "summary": "OpenAPI contracts, versioned paths, timeouts, retries only when idempotent.",
      "file": "modules/communication/rest-sync.md",
      "when": [
        "request response"
      ],
      "requires": [
        [
          "microservices",
          "serverless"
        ]
      ],
      "default": true
    },
    {
      "id": "async-events",
      "category": "communication",
      "version": "1.0.0",
      "title": "Asynchronous events",
      "summary": "AsyncAPI, transactional outbox, idempotent consumers, dead letters.",

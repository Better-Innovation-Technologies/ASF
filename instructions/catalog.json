          "enum": [
            "English",
            "Italian",
            "Spanish",
            "French",
            "German",
            "Portuguese"
          ]
        },
        {
          "name": "business_language",
          "type": "enum",
          "description": "Language the business speaks",
          "default": "Italian",
          "enum": [
            "English",
            "Italian",
            "Spanish",
            "French",
            "German",
            "Portuguese"
          ]
        },
        {
          "name": "glossary_path",
          "type": "path",
          "description": "Path of the domain glossary",
          "default": "docs/glossary.md"
        }
      ]
    },
    {
      "id": "language-local-domain-terms",
      "category": "language",
      "version": "1.0.0",

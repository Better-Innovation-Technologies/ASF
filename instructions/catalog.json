    {
      "id": "i18n-icu",
      "category": "localization",
      "version": "1.0.0",
      "title": "Multi-locale (ICU)",
      "summary": "Message catalogs per locale, ICU MessageFormat, locale-aware formatting.",
      "file": "modules/localization/i18n-icu.md",
      "when": [
